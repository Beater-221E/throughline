{
  "patterns": [
    { "regex": "(?<![A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}", "flags": "", "label": "openai-key" },
    { "regex": "ghp_[A-Za-z0-9]{30,}", "flags": "", "label": "github-token" },
    { "regex": "github_pat_[A-Za-z0-9_]{30,}", "flags": "", "label": "github-pat" },
    { "regex": "AKIA[0-9A-Z]{16}", "flags": "", "label": "aws-key" },
    { "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----", "flags": "", "label": "private-key" },
    { "regex": "\\b(bearer)\\s+[A-Za-z0-9._-]{20,}", "flags": "i", "label": "bearer" },
    { "regex": "\\b(password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token)\\s*[:=]\\s*[\"']?[A-Za-z0-9!@#$%^&*._-]{8,}", "flags": "i", "label": "password-assignment" }
  ]
}
